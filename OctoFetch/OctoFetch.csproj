<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>false</UseWindowsForms>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<RootNamespace>OctoFetch</RootNamespace>
		<AssemblyName>OctoFetch</AssemblyName>
		<Version>1.0.1</Version>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
		<PackageReference Include="MaterialDesignColors" Version="5.3.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.7" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.7" />
		<PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Octokit" Version="14.0.0" />
		<PackageReference Include="Google.Apis.Drive.v3" Version="1.73.0.4112" />
		<PackageReference Include="Google.Apis.Auth" Version="1.73.0" />
		<!-- libsodium-managed wrapper. Needed only to encrypt the user's Drive
		     OAuth refresh token before pushing it as a repo secret (GitHub's
		     Actions secrets API uses crypto_box_seal). The native libsodium
		     DLLs ship via runtime/ folders inside the package. -->
		<PackageReference Include="Sodium.Core" Version="1.3.4" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\smart-downloader.yml" />
		<EmbeddedResource Include="Resources\youtube_downloader.yml" />
		<EmbeddedResource Include="Resources\drive_uploader.yml" />
		<EmbeddedResource Include="Resources\youtube_drive_uploader.yml" />
		<EmbeddedResource Include="Resources\release_uploader.yml" />
		<EmbeddedResource Include="Resources\youtube_release_uploader.yml" />
		<EmbeddedResource Include="Resources\MITM-DomainFronting.json" />
	</ItemGroup>

	<ItemGroup>
		<None Update="GitCore\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="MitmCore\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
