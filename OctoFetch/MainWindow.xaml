<Window x:Class="OctoFetch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OctoFetch.ViewModels"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:tabs="clr-namespace:OctoFetch.Views.Tabs"
        xmlns:ctl="clr-namespace:OctoFetch.Views.Controls"
        mc:Ignorable="d"
        Title="OctoFetch"
        Height="820" Width="1280"
        MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource BrandFont}"
        TextElement.Foreground="{StaticResource TextPrimary}"
        TextElement.FontSize="13"
        AllowDrop="True"
        Drop="Window_Drop"
        PreviewDragOver="Window_PreviewDragOver"
        MouseDown="Window_MouseDown"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.CacheMode>
        <BitmapCache RenderAtScale="1"/>
    </Window.CacheMode>

    <Border Background="{StaticResource WindowBackdrop}"
            CornerRadius="15" Margin="14"
            md:RippleAssist.IsDisabled="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="8" Opacity="0.30"
                                RenderingBias="Performance"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ctl:AppSidebar Grid.Column="0" DataContext="{Binding}"/>

            <!-- ============================== Right side ============================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Height="48" Margin="20,12,20,0" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="OCTOFETCH"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource ChromeIconButton}"
                                ToolTip="Minimize" Click="BtnMinimize_Click">
                            <md:PackIcon Kind="WindowMinimize" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource ChromeCloseButton}"
                                Margin="6,0,0,0"
                                ToolTip="Close" Click="BtnClose_Click">
                            <md:PackIcon Kind="WindowClose" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Tab content area -->
                <Grid Grid.Row="1" Margin="20,12,20,20"
                      md:TransitionAssist.DisableTransitions="True">
                    <Grid Style="{StaticResource TabPaneAnim}"
                          Visibility="{Binding IsDashboardActive, Converter={StaticResource BoolToVisibility}}">
                        <tabs:DashboardView DataContext="{Binding Dashboard}"/>
                    </Grid>
                    <Grid Style="{StaticResource TabPaneAnim}"
                          Visibility="{Binding IsFileManagerActive, Converter={StaticResource BoolToVisibility}}">
                        <tabs:FileManagerView x:Name="FileManagerHost" DataContext="{Binding FileManager}"/>
                    </Grid>
                    <Grid Style="{StaticResource TabPaneAnim}"
                          Visibility="{Binding IsExtractorActive, Converter={StaticResource BoolToVisibility}}">
                        <tabs:ExtractorView DataContext="{Binding Extractor}"/>
                    </Grid>
                    <Grid Style="{StaticResource TabPaneAnim}"
                          Visibility="{Binding IsStatsActive, Converter={StaticResource BoolToVisibility}}">
                        <tabs:StatsView DataContext="{Binding}"/>
                    </Grid>
                    <Grid Style="{StaticResource TabPaneAnim}"
                          Visibility="{Binding IsYouTubeActive, Converter={StaticResource BoolToVisibility}}">
                        <tabs:YouTubeView DataContext="{Binding YouTube}"/>
                    </Grid>
                    <Grid Style="{StaticResource TabPaneAnim}"
                          Visibility="{Binding IsDownloaderActive, Converter={StaticResource BoolToVisibility}}">
                        <tabs:DownloaderView DataContext="{Binding Downloader}"/>
                    </Grid>
                    <Grid Style="{StaticResource TabPaneAnim}"
                          Visibility="{Binding IsSettingsActive, Converter={StaticResource BoolToVisibility}}">
                        <tabs:SettingsView x:Name="SettingsHost" DataContext="{Binding}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
