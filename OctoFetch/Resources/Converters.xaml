<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:OctoFetch.Converters">

    <conv:BoolToVisibilityConverter        x:Key="BoolToVisibility"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    <conv:StringToVisibilityConverter      x:Key="StringToVisibility"/>
    <conv:StringToBrushConverter      x:Key="StringToBrush"/>
    <conv:InverseBoolConverter        x:Key="InverseBool"/>
    <conv:BytesToHumanConverter       x:Key="BytesToHuman"/>
    <conv:CachedImageConverter        x:Key="CachedImage"/>

</ResourceDictionary>
