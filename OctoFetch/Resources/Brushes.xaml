<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Brand.Bg">#FF0B0B11</Color>
    <Color x:Key="Brand.Sidebar">#FF13131D</Color>
    <Color x:Key="Brand.Card">#FF1A1A26</Color>
    <Color x:Key="Brand.CardElevated">#FF20202E</Color>
    <Color x:Key="Brand.Input">#FF0F0F18</Color>
    <Color x:Key="Brand.Border">#FF252533</Color>
    <Color x:Key="Brand.BorderHover">#FF36364A</Color>
    <Color x:Key="Brand.TextPrimary">#FFF2F2F7</Color>
    <Color x:Key="Brand.TextSecondary">#FF9B9BA8</Color>
    <Color x:Key="Brand.TextMuted">#FF6B6B78</Color>
    <Color x:Key="Brand.AccentCyan">#FF00D4FF</Color>
    <Color x:Key="Brand.AccentPurple">#FFA78BFA</Color>
    <Color x:Key="Brand.Success">#FF10B981</Color>
    <Color x:Key="Brand.Danger">#FFEF4444</Color>
    <Color x:Key="Brand.Warning">#FFF59E0B</Color>
    <Color x:Key="Brand.Info">#FF60A5FA</Color>

    <SolidColorBrush x:Key="BgMain"             Color="{StaticResource Brand.Bg}" />
    <SolidColorBrush x:Key="BgSidebar"          Color="{StaticResource Brand.Sidebar}" />
    <SolidColorBrush x:Key="BgCard"             Color="{StaticResource Brand.Card}" />
    <SolidColorBrush x:Key="BgCardElevated"     Color="{StaticResource Brand.CardElevated}" />
    <SolidColorBrush x:Key="BgInput"            Color="{StaticResource Brand.Input}" />
    <SolidColorBrush x:Key="BorderBrushDefault" Color="{StaticResource Brand.Border}" />
    <SolidColorBrush x:Key="BorderBrushHover"   Color="{StaticResource Brand.BorderHover}" />
    <SolidColorBrush x:Key="TextPrimary"        Color="{StaticResource Brand.TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondary"      Color="{StaticResource Brand.TextSecondary}" />
    <SolidColorBrush x:Key="TextMuted"          Color="{StaticResource Brand.TextMuted}" />
    <SolidColorBrush x:Key="AccentCyanBrush"    Color="{StaticResource Brand.AccentCyan}" />
    <SolidColorBrush x:Key="AccentPurpleBrush"  Color="{StaticResource Brand.AccentPurple}" />
    <SolidColorBrush x:Key="SuccessBrush"       Color="{StaticResource Brand.Success}" />
    <SolidColorBrush x:Key="DangerBrush"        Color="{StaticResource Brand.Danger}" />
    <SolidColorBrush x:Key="WarningBrush"       Color="{StaticResource Brand.Warning}" />
    <SolidColorBrush x:Key="InfoBrush"          Color="{StaticResource Brand.Info}" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Brand.AccentCyan}"   Offset="0" />
        <GradientStop Color="{StaticResource Brand.AccentPurple}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WindowBackdrop" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0B0B11" Offset="0" />
        <GradientStop Color="#FF111119" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="BrandFont">Inter, Segoe UI, system</FontFamily>

</ResourceDictionary>
