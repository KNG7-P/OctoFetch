<UserControl x:Class="OctoFetch.Views.Tabs.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OctoFetch.ViewModels"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Servers" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Each server is a free GitHub account that does the heavy lifting in parallel."
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <md:Card Grid.Row="1" Background="{StaticResource BgCard}"
                 UniformCornerRadius="14" Padding="20,18" Margin="0,0,0,12"
                 md:ElevationAssist.Elevation="Dp1"
                 DataContext="{Binding NodeManagement}">
            <StackPanel>
                <TextBlock Text="ADD A SERVER" Style="{StaticResource SectionLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox Grid.Column="0" x:Name="PwdNewToken"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 md:HintAssist.Hint="Personal access token (PAT)"
                                 md:HintAssist.IsFloating="True"
                                 Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="Repository name"
                             md:HintAssist.IsFloating="True"
                             Text="{Binding NewRepoName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="8,0"/>
                    <Button Grid.Column="2" Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{StaticResource AccentGradient}"
                            BorderBrush="{StaticResource AccentGradient}"
                            Foreground="White"
                            md:ButtonAssist.CornerRadius="10"
                            Margin="8,0,0,0" Padding="18,8"
                            Command="{Binding AddNodeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Plus" Width="14" Height="14"
                                         Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Add" VerticalAlignment="Center" FontSize="12.5"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </md:Card>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <md:Card Grid.Column="0" Background="{StaticResource BgCard}"
                     UniformCornerRadius="14" Padding="6"
                     md:ElevationAssist.Elevation="Dp1"
                     DataContext="{Binding NodeManagement}">
                <ListView Background="Transparent" BorderThickness="0"
                          ItemsSource="{Binding Nodes}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border CornerRadius="10"
                                                Background="#FF14141E"
                                                BorderBrush="#FF1F1F2C" BorderThickness="1"
                                                Padding="14,10">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="10" Height="10"
                                         Margin="0,0,12,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding BadgeColor, Converter={StaticResource StringToBrush}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="2" Background="#FF20202E" CornerRadius="6"
                                        Padding="8,3" Margin="6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VisibilityText}"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                                <Button Grid.Column="3" Style="{StaticResource MaterialDesignIconButton}"
                                        Width="32" Height="32" Margin="2,0"
                                        ToolTip="Toggle visibility"
                                        Command="{Binding DataContext.ToggleNodeVisibilityCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}">
                                    <md:PackIcon Kind="EyeOutline" Width="14" Height="14"/>
                                </Button>
                                <Button Grid.Column="4" Style="{StaticResource MaterialDesignIconButton}"
                                        Width="32" Height="32" Margin="2,0"
                                        Foreground="{StaticResource DangerBrush}"
                                        ToolTip="Remove server"
                                        Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}">
                                    <md:PackIcon Kind="TrashCanOutline" Width="14" Height="14"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </md:Card>

            <md:Card Grid.Column="1" Margin="12,0,0,0"
                     Background="{StaticResource BgCard}"
                     UniformCornerRadius="14" Padding="0"
                     md:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#FF14141E">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,12">
                            <md:PackIcon Kind="MessageTextOutline" Width="16" Height="16"
                                         Foreground="{StaticResource AccentCyanBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Server log"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{StaticResource TextMuted}"
                                Margin="0,4,12,4" Padding="10,4" FontSize="11"
                                Command="{Binding DataContext.ClearSettingsLogsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Broom" Width="13" Height="13"
                                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Clear" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Padding="14,12,6,14">
                        <ItemsControl Margin="8,0,8,0"
                                      ItemsSource="{Binding DataContext.SettingsLogs, RelativeSource={RelativeSource AncestorType=Window}}"
                                      ItemTemplate="{StaticResource LogEntryTemplate}"/>
                    </ScrollViewer>
                </Grid>
            </md:Card>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    DataContext="{Binding NodeManagement}">
            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                    BorderBrush="{StaticResource BorderBrushDefault}"
                    Foreground="{StaticResource TextSecondary}"
                    md:ButtonAssist.CornerRadius="10"
                    Padding="14,6" Margin="0,0,8,0"
                    Command="{Binding SaveSettingsCommand}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="ContentSave" Width="14" Height="14"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Save" VerticalAlignment="Center" FontSize="12.5"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{StaticResource AccentGradient}"
                    BorderBrush="{StaticResource AccentGradient}"
                    Foreground="White"
                    md:ButtonAssist.CornerRadius="10"
                    Padding="20,6"
                    Command="{Binding TestAllNodesCommand}"
                    IsEnabled="{Binding IsTestingNodes, Converter={StaticResource InverseBool}}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="LightningBolt" Width="14" Height="14"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Test all servers" VerticalAlignment="Center"
                               FontSize="12.5" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
