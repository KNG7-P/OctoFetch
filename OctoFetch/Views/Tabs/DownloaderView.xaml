<UserControl x:Class="OctoFetch.Views.Tabs.DownloaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OctoFetch.ViewModels"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DownloaderViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Downloads" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding SummaryText}"
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedButton}"
                    BorderBrush="{StaticResource BorderBrushDefault}"
                    Foreground="{StaticResource TextSecondary}"
                    md:ButtonAssist.CornerRadius="10"
                    Padding="12,5" Margin="0,0,8,0"
                    Command="{Binding ClearCompletedCommand}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Broom" Width="14" Height="14"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Clear done" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource MaterialDesignOutlinedButton}"
                    BorderBrush="{StaticResource AccentCyanBrush}"
                    Foreground="{StaticResource AccentCyanBrush}"
                    md:ButtonAssist.CornerRadius="10"
                    Padding="12,5"
                    Command="{Binding OpenOutputFolderCommand}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="FolderOpenOutline" Width="14" Height="14"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Open folder" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Summary card -->
        <md:Card Grid.Row="1" Background="{StaticResource BgCard}"
                 UniformCornerRadius="12" Padding="16,12" Margin="0,0,0,10"
                 md:ElevationAssist.Elevation="Dp0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <md:PackIcon Grid.Column="0" Kind="DownloadMultiple" Width="24" Height="24"
                             Foreground="{StaticResource AccentCyanBrush}"
                             VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SummaryText}"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}" FontSize="11.5">
                    <Run Text="Active: "/><Run Text="{Binding ActiveCount, Mode=OneWay}"/>
                    <Run Text=" · Done: "/><Run Text="{Binding CompletedCount, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </md:Card>

        <!-- Queue list -->
        <md:Card Grid.Row="2" Background="{StaticResource BgCard}"
                 UniformCornerRadius="14" Padding="6"
                 md:ElevationAssist.Elevation="Dp0">
            <Grid>
                <ListView Background="Transparent" BorderThickness="0"
                          ItemsSource="{Binding Queue}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.PanningMode="VerticalOnly"
                          ScrollViewer.IsDeferredScrollingEnabled="False"
                          ScrollViewer.CanContentScroll="True">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,3"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border CornerRadius="10"
                                                Background="#FF14141E"
                                                BorderBrush="#FF1F1F2C" BorderThickness="1"
                                                Padding="14,12">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Grid.Column="0" Width="36" Height="36"
                                            Background="#FF1F1F2D" CornerRadius="9"
                                            Margin="0,0,12,0">
                                        <md:PackIcon Kind="FolderDownloadOutline" Width="18" Height="18"
                                                     Foreground="{StaticResource AccentCyanBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                       Foreground="{StaticResource TextMuted}"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                       Foreground="{StaticResource TextMuted}"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding SpeedText}" FontSize="11"
                                                       Foreground="{StaticResource AccentCyanBrush}"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding EtaText}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Pause/Resume toggle (hidden when finished) -->
                                    <Button Grid.Column="2"
                                            Width="30" Height="30" Margin="4,0"
                                            ToolTip="Pause / Resume"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                                <Setter Property="Command" Value="{Binding DataContext.PauseItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                        <Setter Property="Command" Value="{Binding DataContext.ResumeItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <md:PackIcon Width="16" Height="16"
                                                     Foreground="{StaticResource TextSecondary}">
                                            <md:PackIcon.Style>
                                                <Style TargetType="md:PackIcon">
                                                    <Setter Property="Kind" Value="Pause"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                            <Setter Property="Kind" Value="Play"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </md:PackIcon.Style>
                                        </md:PackIcon>
                                    </Button>

                                    <!-- Cancel (hidden when finished) -->
                                    <Button Grid.Column="3" Style="{StaticResource MaterialDesignIconButton}"
                                            Width="30" Height="30" Margin="2,0"
                                            ToolTip="Cancel"
                                            Command="{Binding DataContext.CancelItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                        <md:PackIcon Kind="Close" Width="14" Height="14"
                                                     Foreground="{StaticResource DangerBrush}"/>
                                    </Button>

                                    <!-- View file in explorer (only shown on completed) -->
                                    <Button Grid.Column="4" Style="{StaticResource MaterialDesignIconButton}"
                                            Width="30" Height="30" Margin="2,0"
                                            ToolTip="Show file in folder"
                                            Command="{Binding DataContext.ViewFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding HasFinalFile, Converter={StaticResource BoolToVisibility}}">
                                        <md:PackIcon Kind="FolderEye" Width="14" Height="14"
                                                     Foreground="{StaticResource AccentCyanBrush}"/>
                                    </Button>

                                    <!-- Remove (only shown when finished) -->
                                    <Button Grid.Column="5" Style="{StaticResource MaterialDesignIconButton}"
                                            Width="30" Height="30" Margin="2,0"
                                            ToolTip="Remove from queue"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}">
                                        <md:PackIcon Kind="TrashCanOutline" Width="14" Height="14"
                                                     Foreground="{StaticResource TextMuted}"/>
                                    </Button>
                                </Grid>

                                <!-- Progress bar -->
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <ProgressBar Height="6" Minimum="0" Maximum="100"
                                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                                 Foreground="{StaticResource AccentCyanBrush}"
                                                 Background="#FF1F1F2C"
                                                 Style="{StaticResource MaterialDesignLinearProgressBar}"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state (shown when queue is empty) -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Queue.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <md:PackIcon Kind="DownloadOff" Width="48" Height="48"
                                 Foreground="{StaticResource TextMuted}"
                                 HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No downloads yet"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock Text="Go to My Files and click the download button on a folder."
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11.5" HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </md:Card>
    </Grid>
</UserControl>
