<UserControl x:Class="OctoFetch.Views.Tabs.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OctoFetch.ViewModels"
             xmlns:conv="clr-namespace:OctoFetch.Converters"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <UserControl.Resources>
        <conv:FractionToHeightConverter x:Key="FractionToHeight"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Usage" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="How much storage each server is using and how often you're downloading."
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                        Background="{StaticResource AccentGradient}"
                        BorderBrush="{StaticResource AccentGradient}"
                        IsEnabled="{Binding IsRefreshingStats, Converter={StaticResource InverseBool}}"
                        Command="{Binding RefreshClusterStatsCommand}"
                        ToolTip="Refresh stats">
                    <md:PackIcon Kind="Refresh" Width="18" Height="18" Foreground="White"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Cluster summary line -->
        <md:Card Grid.Row="1" Background="{StaticResource BgCard}"
                 UniformCornerRadius="14" Padding="20,14" Margin="0,0,0,12"
                 md:ElevationAssist.Elevation="Dp0">
            <TextBlock Text="{Binding ClusterStatsSummary}"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="13"/>
        </md:Card>

        <!-- Daily / Weekly / Monthly chart card -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <md:Card Background="{StaticResource BgCard}"
                     UniformCornerRadius="14" Padding="18,14"
                     md:ElevationAssist.Elevation="Dp0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title + range toggle -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DOWNLOAD ACTIVITY"
                                       Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding ChartSummary}"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="11.5" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                          IsChecked="{Binding IsDailyChartActive, Mode=OneWay}"
                                          Foreground="{StaticResource AccentCyanBrush}"
                                          Margin="0,0,4,0" Padding="12,4"
                                          Command="{Binding SelectChartRangeCommand}"
                                          CommandParameter="Daily">
                                <TextBlock Text="Daily" FontSize="12"/>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                          IsChecked="{Binding IsWeeklyChartActive, Mode=OneWay}"
                                          Foreground="{StaticResource AccentCyanBrush}"
                                          Margin="0,0,4,0" Padding="12,4"
                                          Command="{Binding SelectChartRangeCommand}"
                                          CommandParameter="Weekly">
                                <TextBlock Text="Weekly" FontSize="12"/>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                          IsChecked="{Binding IsMonthlyChartActive, Mode=OneWay}"
                                          Foreground="{StaticResource AccentCyanBrush}"
                                          Padding="12,4"
                                          Command="{Binding SelectChartRangeCommand}"
                                          CommandParameter="Monthly">
                                <TextBlock Text="Monthly" FontSize="12"/>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>

                    <!-- Daily series -->
                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding DailyChart}"
                                  Height="148"
                                  Margin="0,12,0,0"
                                  Visibility="{Binding IsDailyChartActive, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="3,0" ToolTip="{Binding Tooltip}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" VerticalAlignment="Bottom"
                                            Background="{StaticResource AccentGradient}"
                                            CornerRadius="4,4,2,2"
                                            Height="{Binding HeightFraction, Converter={StaticResource FractionToHeight}, ConverterParameter=120}"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Count}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="10.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="2" Text="{Binding Label}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Weekly series -->
                    <ItemsControl Grid.Row="2"
                                  ItemsSource="{Binding WeeklyChart}"
                                  Height="148"
                                  Margin="0,12,0,0"
                                  Visibility="{Binding IsWeeklyChartActive, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="3,0" ToolTip="{Binding Tooltip}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" VerticalAlignment="Bottom"
                                            Background="{StaticResource AccentGradient}"
                                            CornerRadius="4,4,2,2"
                                            Height="{Binding HeightFraction, Converter={StaticResource FractionToHeight}, ConverterParameter=120}"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Count}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="10.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="2" Text="{Binding Label}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Monthly series -->
                    <ItemsControl Grid.Row="3"
                                  ItemsSource="{Binding MonthlyChart}"
                                  Height="148"
                                  Margin="0,12,0,0"
                                  Visibility="{Binding IsMonthlyChartActive, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="3,0" ToolTip="{Binding Tooltip}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" VerticalAlignment="Bottom"
                                            Background="{StaticResource AccentGradient}"
                                            CornerRadius="4,4,2,2"
                                            Height="{Binding HeightFraction, Converter={StaticResource FractionToHeight}, ConverterParameter=120}"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Count}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="10.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="2" Text="{Binding Label}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </md:Card>

            <!-- Loader overlay during cluster-stats refresh -->
            <Border Background="#CC0F0F18"
                    CornerRadius="14"
                    Visibility="{Binding IsRefreshingStats, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <md:PackIcon Kind="Loading" Width="32" Height="32"
                                 Foreground="{StaticResource AccentCyanBrush}"
                                 HorizontalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5">
                        <md:PackIcon.RenderTransform>
                            <RotateTransform x:Name="StatsSpinnerRotate"/>
                        </md:PackIcon.RenderTransform>
                        <md:PackIcon.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="StatsSpinnerRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </md:PackIcon.Triggers>
                    </md:PackIcon>
                    <TextBlock Text="Refreshing stats…"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            
            <Border Background="#CC0F0F18"
                    CornerRadius="14"
                    Visibility="{Binding IsImportingHistory, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <md:PackIcon Kind="Loading" Width="32" Height="32"
                                 Foreground="{StaticResource AccentCyanBrush}"
                                 HorizontalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5">
                        <md:PackIcon.RenderTransform>
                            <RotateTransform x:Name="ImportSpinnerRotate"/>
                        </md:PackIcon.RenderTransform>
                        <md:PackIcon.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="ImportSpinnerRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </md:PackIcon.Triggers>
                    </md:PackIcon>
                    <TextBlock Text="Importing history from GitHub…"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                    <TextBlock Text="Reading the last 180 days of commits."
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Per-server breakdown -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding ClusterStats}" Margin="0,0,4,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <md:Card Background="{StaticResource BgCard}"
                                 UniformCornerRadius="12" Padding="16,12"
                                 Margin="0,0,0,8"
                                 md:ElevationAssist.Elevation="Dp0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Margin="0,0,10,0"
                                             VerticalAlignment="Center"
                                             Fill="{Binding BadgeColor, Converter={StaticResource StringToBrush}}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RepoName}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Foreground="{StaticResource TextMuted}"
                                                   FontSize="11">
                                            <Run Text="{Binding FolderCount}"/>
                                            <Run Text="folder(s) ·"/>
                                            <Run Text="{Binding FileCount}"/>
                                            <Run Text="file(s)"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Foreground="{StaticResource AccentCyanBrush}"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Text="{Binding TotalBytes, Converter={StaticResource BytesToHuman}}"/>
                            </Grid>
                        </md:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
