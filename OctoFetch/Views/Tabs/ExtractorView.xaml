<UserControl x:Class="OctoFetch.Views.Tabs.ExtractorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OctoFetch.ViewModels"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ExtractorViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Extract zip" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Pick all .zip.001/.002/… parts of a download — we'll join and extract them locally."
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <md:Card Grid.Row="1" Background="{StaticResource BgCard}"
                 UniformCornerRadius="14" Padding="20,18" Margin="0,0,0,12"
                 md:ElevationAssist.Elevation="Dp1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource BgInput}"
                        BorderBrush="{StaticResource BorderBrushDefault}"
                        BorderThickness="1"
                        CornerRadius="10" Padding="12,10" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ZipBoxOutline" Width="16" Height="16"
                                     Foreground="{StaticResource AccentCyanBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding DisplayPath, FallbackValue='No parts selected.'}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Button Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="{StaticResource AccentCyanBrush}"
                        Foreground="{StaticResource AccentCyanBrush}"
                        md:ButtonAssist.CornerRadius="10"
                        Padding="14,6"
                        Command="{Binding BrowseCommand}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="FolderSearchOutline" Width="14" Height="14"
                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Browse" VerticalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                </Button>
            </Grid>
        </md:Card>

        <md:Card Grid.Row="2" Background="{StaticResource BgCard}"
                 UniformCornerRadius="14" Padding="0"
                 md:ElevationAssist.Elevation="Dp1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="#FF14141E">
                    <StackPanel Orientation="Horizontal" Margin="20,12">
                        <md:PackIcon Kind="MessageTextOutline" Width="16" Height="16"
                                     Foreground="{StaticResource AccentCyanBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Activity log"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Padding="20,12,6,14">
                    <ItemsControl Margin="8,0,8,0"
                                  ItemsSource="{Binding DataContext.ExtractorLogs, RelativeSource={RelativeSource AncestorType=Window}}"
                                  ItemTemplate="{StaticResource LogEntryTemplate}"/>
                </ScrollViewer>
            </Grid>
        </md:Card>

        <Button Grid.Row="3" Style="{StaticResource MaterialDesignRaisedButton}"
                Background="{StaticResource AccentGradient}"
                BorderBrush="{StaticResource AccentGradient}"
                Foreground="White"
                md:ButtonAssist.CornerRadius="12"
                HorizontalAlignment="Right" Margin="0,12,0,0"
                Padding="22,8"
                Command="{Binding ExtractCommand}">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="ZipBox" Width="16" Height="16"
                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Extract" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
