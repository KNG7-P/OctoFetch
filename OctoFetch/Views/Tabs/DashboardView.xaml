<UserControl x:Class="OctoFetch.Views.Tabs.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OctoFetch.ViewModels"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Drop a link, paste a URL, or paste a YouTube video — we'll route it to the right pipeline."
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- Card 1: URL entry + start -->
        <md:Card Grid.Row="1" Background="{StaticResource BgCard}"
                 UniformCornerRadius="14" Padding="20,18"
                 md:ElevationAssist.Elevation="Dp0">
            <StackPanel>
                <TextBlock Text="DOWNLOAD" Style="{StaticResource SectionLabel}"
                           Margin="0,0,0,8"/>

                <!-- Single mode -->
                <Grid Visibility="{Binding IsBulkMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="https:// download link or YouTube URL"
                             md:HintAssist.IsFloating="True"
                             md:TextFieldAssist.HasClearButton="True"
                             Text="{Binding TargetUrl, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13.5" Padding="12,12"/>
                </Grid>

                <!-- Bulk mode -->
                <Grid Visibility="{Binding IsBulkMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="One link per line — https or YouTube; processed in order"
                             md:HintAssist.IsFloating="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             MinHeight="92"
                             MaxHeight="160"
                             Text="{Binding BulkUrls, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" FontFamily="Cascadia Code, Consolas, monospace"
                             Padding="12,10"/>
                </Grid>

                <!-- Switches + actions -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton Style="{StaticResource CompactToggleSwitch}"
                                      IsChecked="{Binding IsSafeNameActive}"/>
                        <TextBlock Text="Safe filename" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="6,0,18,0" FontSize="12"/>
                        <ToggleButton Style="{StaticResource CompactToggleSwitch}"
                                      IsChecked="{Binding IsObfuscateNameActive}"/>
                        <TextBlock Text="Obfuscate name" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="6,0,18,0" FontSize="12"/>
                        <ToggleButton Style="{StaticResource CompactToggleSwitch}"
                                      IsChecked="{Binding IsBulkMode, Mode=TwoWay}"
                                      ToolTip="Toggle bulk mode"/>
                        <TextBlock Text="Bulk mode" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12"/>
                    </StackPanel>

                    <!-- Right cluster: Category | Cancel | Start -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox Width="150"
                                  Style="{StaticResource CompactComboBox}"
                                  md:HintAssist.Hint="Category"
                                  ItemsSource="{Binding AvailableTags}"
                                  SelectedItem="{Binding SelectedTag}"
                                  Margin="0,0,8,0"/>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="{StaticResource DangerBrush}"
                                Foreground="{StaticResource DangerBrush}"
                                md:ButtonAssist.CornerRadius="10"
                                Padding="14,6"
                                Command="{Binding CancelLeechCommand}"
                                Visibility="{Binding IsLeechRunning, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Close" Width="14" Height="14"
                                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Cancel" VerticalAlignment="Center" FontSize="12.5"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{StaticResource AccentGradient}"
                                BorderBrush="{StaticResource AccentGradient}"
                                Foreground="White"
                                md:ButtonAssist.CornerRadius="10"
                                Padding="20,6"
                                Command="{Binding StartLeechCommand}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="RocketLaunch" Width="15" Height="15"
                                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Start" VerticalAlignment="Center"
                                           FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </md:Card>

        <!-- Card 2: Progress / queue -->
        <md:Card Grid.Row="2" Margin="0,12,0,0"
                 Background="{StaticResource BgCard}"
                 UniformCornerRadius="14" Padding="20,16"
                 md:ElevationAssist.Elevation="Dp0"
                 Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Inline indeterminate spinner while the cloud run is live.
                         Re-uses the same MaterialDesignCircularProgressBar style
                         used on the YouTube tab so the visual language stays
                         consistent across the app. -->
                    <ProgressBar Grid.Column="0"
                                 Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 IsIndeterminate="True"
                                 Foreground="{StaticResource AccentCyanBrush}"
                                 Width="16" Height="16"
                                 VerticalAlignment="Center" Margin="0,0,10,0"
                                 Visibility="{Binding IsLeechRunning, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressLabel}"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="2" Background="#FF14141E" CornerRadius="6"
                            Padding="8,2" Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsLeechRunning, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ClockOutline" Width="12" Height="12"
                                         Foreground="{StaticResource TextMuted}"
                                         VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding ElapsedText}"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontFamily="Cascadia Code, Consolas, monospace"
                                       FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="3"
                               Foreground="{StaticResource AccentCyanBrush}"
                               FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center">
                        <Run Text="{Binding ProgressValue}"/><Run Text="%"/>
                    </TextBlock>
                </Grid>
                <ProgressBar Style="{StaticResource MaterialDesignLinearProgressBar}"
                             Height="8" Foreground="{StaticResource AccentCyanBrush}"
                             Background="#FF1B1B27"
                             Value="{Binding ProgressValue}"/>
                <Border Margin="0,10,0,0" Padding="10,7"
                        Background="#FF14141E" CornerRadius="8"
                        Visibility="{Binding IsQueueVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="FormatListNumbered" Width="14" Height="14"
                                     Foreground="{StaticResource AccentPurpleBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding QueueStatusText}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </md:Card>

        <!-- Card 3: Logs + Links -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <md:Card Grid.Column="0" Background="{StaticResource BgCard}"
                     UniformCornerRadius="14" Padding="0"
                     md:ElevationAssist.Elevation="Dp0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#FF14141E">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,12,0,12">
                            <md:PackIcon Kind="MessageTextOutline" Width="16" Height="16"
                                         Foreground="{StaticResource AccentCyanBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Activity log"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{StaticResource TextMuted}"
                                Margin="0,4,12,4" Padding="10,4" FontSize="11"
                                Command="{Binding DataContext.ClearDownloaderLogsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Broom" Width="13" Height="13"
                                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Clear" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding DataContext.DownloaderLogs, RelativeSource={RelativeSource AncestorType=Window}}"
                             ItemTemplate="{StaticResource LogEntryTemplate}"
                             Background="Transparent" BorderThickness="0"
                             Padding="20,12,6,14" Margin="8,0,8,0"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionMode="Single"
                             IsHitTestVisible="True"
                             Focusable="False">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </md:Card>

            <md:Card Grid.Column="1" Margin="12,0,0,0"
                     Background="{StaticResource BgCard}"
                     UniformCornerRadius="14" Padding="0"
                     md:ElevationAssist.Elevation="Dp0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#FF14141E">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,12,0,12">
                            <md:PackIcon Kind="LinkVariant" Width="16" Height="16"
                                         Foreground="{StaticResource AccentPurpleBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Foreground="{StaticResource TextPrimary}"
                                       FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <Run Text="Links"/>
                                <Run Text=" ("/><Run Text="{Binding Links.Count, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{StaticResource TextMuted}"
                                Margin="0,4,12,4" Padding="10,4" FontSize="11"
                                Command="{Binding ClearLinksCommand}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Broom" Width="13" Height="13"
                                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Clear" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Links}"
                             Background="Transparent" BorderThickness="0"
                             Padding="20,12,6,10" Margin="2,0,8,0"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionMode="Single"
                             Focusable="False">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3" Padding="12,9"
                                        Background="#FF14141E"
                                        BorderBrush="#FF1F1F2C" BorderThickness="1"
                                        CornerRadius="9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FileName}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Url}"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontSize="10.5" Margin="0,1,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Width="32" Height="32" Margin="6,0,0,0"
                                                ToolTip="Copy link"
                                                CommandParameter="{Binding Url}"
                                                Command="{Binding DataContext.CopySingleLinkCommand, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                            <md:PackIcon Kind="ContentCopy" Width="14" Height="14"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- "Copy all links" button -->
                    <Button Grid.Row="2" Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="{StaticResource AccentCyanBrush}"
                            Foreground="{StaticResource AccentCyanBrush}"
                            md:ButtonAssist.CornerRadius="10"
                            Margin="14,4,14,12" Padding="0,8"
                            Command="{Binding CopyAllLinksCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <md:PackIcon Kind="ContentCopy" Width="14" Height="14"
                                         Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Copy all links" VerticalAlignment="Center" FontSize="12.5"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </md:Card>
        </Grid>
    </Grid>
</UserControl>
