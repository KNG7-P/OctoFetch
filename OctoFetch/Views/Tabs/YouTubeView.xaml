<UserControl x:Class="OctoFetch.Views.Tabs.YouTubeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OctoFetch.ViewModels"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:OctoFetch.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:YouTubeViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="YouTube" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Search videos, explore channels, and download directly to your GitHub servers."
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- Search bar -->
        <md:Card Grid.Row="1" Background="{StaticResource BgCard}"
                 UniformCornerRadius="14" Padding="16,14"
                 md:ElevationAssist.Elevation="Dp0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="Search YouTube or paste channel URL…"
                         md:HintAssist.IsFloating="True"
                         md:TextFieldAssist.HasClearButton="True"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13.5" Padding="12,12"
                         KeyDown="SearchBox_KeyDown"/>
                <Button Grid.Column="1"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{StaticResource AccentGradient}"
                        BorderBrush="{StaticResource AccentGradient}"
                        Foreground="White"
                        md:ButtonAssist.CornerRadius="10"
                        Padding="18,6" Margin="10,0,0,0"
                        Command="{Binding SearchCommand}"
                        IsEnabled="{Binding IsSearching, Converter={StaticResource InverseBool}}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Magnify" Width="16" Height="16"
                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Search" VerticalAlignment="Center"
                                   FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="{StaticResource BorderBrushDefault}"
                        Foreground="{StaticResource TextSecondary}"
                        md:ButtonAssist.CornerRadius="10"
                        Padding="10,6" Margin="6,0,0,0"
                        Command="{Binding ReloadCommand}"
                        IsEnabled="{Binding IsSearching, Converter={StaticResource InverseBool}}"
                        ToolTip="Reload the current results (e.g. after toggling MITM)">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Refresh" Width="14" Height="14"
                                     Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Reload" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="{StaticResource BorderBrushDefault}"
                        Foreground="{StaticResource TextSecondary}"
                        md:ButtonAssist.CornerRadius="10"
                        Padding="12,6" Margin="6,0,0,0"
                        Command="{Binding BackToSearchCommand}"
                        Visibility="{Binding IsChannelView, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ArrowLeft" Width="14" Height="14"
                                     Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Back" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>
        </md:Card>
        
        <md:Card Grid.Row="2" Margin="0,10,0,0"
                 Background="{StaticResource BgCard}"
                 UniformCornerRadius="14" Padding="0"
                 md:ElevationAssist.Elevation="Dp0"
                 Visibility="{Binding IsChannelView, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Banner strip -->
                <Border Grid.Row="0" CornerRadius="14,14,0,0"
                        Background="{StaticResource AccentGradient}"
                        Opacity="0.85"/>

                <!-- Avatar + meta -->
                <Grid Grid.Row="1" Margin="18,0,18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36"
                            Margin="0,-32,16,0" BorderThickness="3"
                            BorderBrush="{StaticResource BgCard}"
                            Background="#FF1F1F2D">
                        <Border CornerRadius="33"
                                conv:ImageAsyncLoader.Url="{Binding ChannelAvatar}">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill"
                                            RenderOptions.BitmapScalingMode="LowQuality"/>
                            </Border.Background>
                        </Border>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ChannelName}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <md:PackIcon Kind="AccountGroupOutline" Width="13" Height="13"
                                         Foreground="{StaticResource AccentCyanBrush}"
                                         VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding ChannelSubs}" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                            <Border Width="3" Height="3" CornerRadius="1.5" Margin="8,0"
                                    Background="{StaticResource TextMuted}"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ChannelVideoCountText, Converter={StaticResource StringToVisibility}}"/>
                            <md:PackIcon Kind="PlayBoxOutline" Width="13" Height="13"
                                         Foreground="{StaticResource AccentCyanBrush}"
                                         VerticalAlignment="Center" Margin="0,0,4,0"
                                         Visibility="{Binding ChannelVideoCountText, Converter={StaticResource StringToVisibility}}"/>
                            <TextBlock Text="{Binding ChannelVideoCountText}" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ChannelDescription}" FontSize="11"
                                   Foreground="{StaticResource TextMuted}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="32" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding ChannelDescription, Converter={StaticResource StringToVisibility}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </md:Card>

        <!-- Status + results -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Margin="4,0,4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filter (All / Long / Shorts) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="Filter:" Foreground="{StaticResource TextMuted}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="100"
                              Style="{StaticResource CompactComboBox}"
                              ItemsSource="{Binding VideoFilterOptions}"
                              SelectedItem="{Binding VideoFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              FontSize="12"/>
                </StackPanel>

                <ProgressBar Grid.Column="1"
                             Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Foreground="{StaticResource AccentCyanBrush}"
                             Width="14" Height="14"
                             VerticalAlignment="Center" Margin="0,0,8,0"
                             Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Status text, trimmed -->
                <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                           Foreground="{StaticResource TextMuted}" FontSize="11.5"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <!-- Result count on the right -->
                <TextBlock Grid.Column="3" Text="{Binding ResultCountText}"
                           Foreground="{StaticResource TextSecondary}" FontSize="11"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>

            <!-- Channel results (shown above videos when not in channel view) -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ItemsControl Grid.Row="0" ItemsSource="{Binding Channels}" Margin="0,0,0,6"
                              Visibility="{Binding IsChannelView, Converter={StaticResource InverseBoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="{StaticResource BorderBrushDefault}"
                                    Foreground="{StaticResource TextSecondary}"
                                    md:ButtonAssist.CornerRadius="20"
                                    Padding="10,4" Margin="0,0,6,6" Height="36"
                                    Command="{Binding DataContext.BrowseChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding ChannelId}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0"
                                            Background="#FF1F1F2D">
                                        <Border CornerRadius="11"
                                                conv:ImageAsyncLoader.Url="{Binding ThumbnailUrl}">
                                            <Border.Background>
                                                <ImageBrush Stretch="UniformToFill"
                                                            RenderOptions.BitmapScalingMode="LowQuality"/>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" FontSize="12">
                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                        <Run Text=" · " Foreground="{StaticResource TextMuted}"/>
                                        <Run Text="{Binding SubscribersText, Mode=OneWay}" Foreground="{StaticResource TextMuted}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Video list -->
                <ListView Grid.Row="1" Background="Transparent" BorderThickness="0"
                          ItemsSource="{Binding FilteredVideos}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.PanningMode="VerticalOnly"
                          ScrollViewer.IsDeferredScrollingEnabled="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="True"
                          SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,3"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd" CornerRadius="12"
                                                Background="#FF14141E"
                                                BorderBrush="#FF1F1F2C" BorderThickness="1"
                                                Padding="10,10">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{StaticResource BorderBrushHover}"/>
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="#FF1A1A28"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{StaticResource AccentCyanBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail -->
                                <Border Grid.Column="0" CornerRadius="8" Height="101"
                                        Background="#FF0D0D14" Margin="0,0,14,0">
                                    <Grid>
                                        <Image conv:ImageAsyncLoader.Url="{Binding ThumbnailUrl}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="LowQuality"
                                               RenderOptions.CachingHint="Cache"/>
                                        <!-- Duration badge for long videos. -->
                                        <Border Background="#CC000000" CornerRadius="4"
                                                Padding="5,2" Margin="6"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Visibility="{Binding IsShort, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock Text="{Binding DurationText}"
                                                       Foreground="White" FontSize="10.5"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                        <!-- Shorts ribbon-->
                                        <Border Background="#E60023" CornerRadius="4"
                                                Padding="5,2" Margin="6"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Visibility="{Binding IsShort, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="Flash" Width="10" Height="10"
                                                             Foreground="White" VerticalAlignment="Center"
                                                             Margin="0,0,3,0"/>
                                                <TextBlock Text="SHORT" Foreground="White" FontSize="9.5"
                                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,2,0,2">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap" MaxHeight="38"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextMuted}">
                                            <Run Text="{Binding ChannelName, Mode=OneWay}"/>
                                        </TextBlock>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Foreground="{StaticResource AccentCyanBrush}"
                                                Padding="4,0" Height="18" MinWidth="0"
                                                FontSize="11" Margin="4,0,0,0"
                                                Command="{Binding DataContext.BrowseChannelCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding ChannelId}"
                                                ToolTip="View channel">
                                            <md:PackIcon Kind="OpenInNew" Width="12" Height="12"/>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0">
                                        <Run Text="{Binding ViewsText, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding UploadedDate, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Action button -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="{StaticResource AccentGradient}"
                                            BorderBrush="{StaticResource AccentGradient}"
                                            Foreground="White"
                                            md:ButtonAssist.CornerRadius="10"
                                            Padding="14,6"
                                            Command="{Binding DataContext.DownloadVideoCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="CloudUpload" Width="14" Height="14"
                                                         Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Transfer" FontSize="11.5"
                                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Load more -->
        <Button Grid.Row="4" Style="{StaticResource MaterialDesignOutlinedButton}"
                BorderBrush="{StaticResource AccentCyanBrush}"
                Foreground="{StaticResource AccentCyanBrush}"
                md:ButtonAssist.CornerRadius="10"
                HorizontalAlignment="Center"
                Padding="28,8" Margin="0,10,0,0"
                Command="{Binding LoadMoreCommand}"
                IsEnabled="{Binding IsLoadingMore, Converter={StaticResource InverseBool}}"
                Visibility="{Binding HasMoreResults, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Foreground="{StaticResource AccentCyanBrush}"
                             Width="14" Height="14"
                             VerticalAlignment="Center" Margin="0,0,8,0"
                             Visibility="{Binding IsLoadingMore, Converter={StaticResource BoolToVisibility}}"/>
                <md:PackIcon Kind="ChevronDown" Width="14" Height="14"
                             Margin="0,0,6,0" VerticalAlignment="Center"
                             Visibility="{Binding IsLoadingMore, Converter={StaticResource InverseBoolToVisibility}}"/>
                <TextBlock Text="Load more" VerticalAlignment="Center" FontSize="13"
                           FontWeight="SemiBold"
                           Visibility="{Binding IsLoadingMore, Converter={StaticResource InverseBoolToVisibility}}"/>
                <TextBlock Text="Loading…" VerticalAlignment="Center" FontSize="13"
                           FontWeight="SemiBold"
                           Visibility="{Binding IsLoadingMore, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
