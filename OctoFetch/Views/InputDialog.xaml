<Window x:Class="OctoFetch.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Rename"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource BrandFont}"
        TextElement.Foreground="{StaticResource TextPrimary}"
        TextOptions.TextFormattingMode="Display"
        ResizeMode="NoResize">
    <Border CornerRadius="14" Background="{StaticResource BgCard}"
            BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1"
            Padding="22,18" MinWidth="420">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="6" Opacity="0.55"/>
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9"
                        Background="{StaticResource AccentGradient}" Margin="0,0,12,0">
                    <md:PackIcon Kind="RenameBox" Width="20" Height="20"
                                 Foreground="White"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PromptText"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
            <TextBox x:Name="InputBox"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     md:HintAssist.Hint="New name"
                     md:HintAssist.IsFloating="True"
                     md:TextFieldAssist.HasClearButton="True"
                     FontSize="13.5" Padding="12,10"
                     KeyDown="InputBox_KeyDown"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="{StaticResource BorderBrushDefault}"
                        Foreground="{StaticResource TextSecondary}"
                        md:ButtonAssist.CornerRadius="10"
                        Padding="14,6" Margin="0,0,8,0"
                        Click="Cancel_Click">
                    <TextBlock Text="Cancel" FontSize="12.5"/>
                </Button>
                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{StaticResource AccentGradient}"
                        BorderBrush="{StaticResource AccentGradient}"
                        Foreground="White"
                        md:ButtonAssist.CornerRadius="10"
                        Padding="20,6"
                        IsDefault="True"
                        Click="Ok_Click">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Check" Width="14" Height="14"
                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Save" FontSize="12.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
 