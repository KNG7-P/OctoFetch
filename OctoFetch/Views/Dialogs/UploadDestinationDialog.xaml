<Window x:Class="OctoFetch.Views.Dialogs.UploadDestinationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Where should this upload?"
        Width="720" Height="320"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource BrandFont}"
        TextElement.Foreground="{StaticResource TextPrimary}"
        TextElement.FontSize="13">

    <Window.Resources>
        <Style x:Key="DestinationCardButton" TargetType="Button">
            <Setter Property="Background" Value="#FF14141E"/>
            <Setter Property="BorderBrush" Value="#FF374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1A1A28"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1F2230"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBackdrop}" CornerRadius="16" Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <Border CornerRadius="16" BorderThickness="1"
                BorderBrush="{StaticResource AccentGradient}"
                Background="{StaticResource BgCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" CornerRadius="16,16,0,0"
                        Background="#FF14141E" Padding="22,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                                Background="{StaticResource AccentGradient}"
                                Margin="0,0,14,0">
                            <md:PackIcon Kind="CloudUploadOutline" Width="22" Height="22"
                                         Foreground="White"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Choose upload destination"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtSubtitle"
                                       Text="Where would you like to send this upload?"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="11.5" Margin="0,3,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                Width="30" Height="30"
                                Foreground="{StaticResource TextMuted}"
                                ToolTip="Close" Click="BtnCancel_Click">
                            <md:PackIcon Kind="WindowClose" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body: three destination cards -->
                <Grid Grid.Row="1" Margin="22,18,22,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- GitHub repo (downloads) -->
                    <Button Grid.Column="0" Click="BtnGitHub_Click"
                            Style="{StaticResource DestinationCardButton}"
                            BorderBrush="#FF374151">
                        <StackPanel>
                            <md:PackIcon Kind="Github" Width="38" Height="38"
                                         Foreground="{StaticResource TextPrimary}"
                                         HorizontalAlignment="Center"
                                         Margin="0,0,0,8"/>
                            <TextBlock Text="Upload to GitHub repo"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontWeight="SemiBold" FontSize="14"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtGitHubStatus"
                                       Text="Cluster of GitHub runners"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="11" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Google Drive -->
                    <Button Grid.Column="2" Click="BtnDrive_Click"
                            Style="{StaticResource DestinationCardButton}"
                            BorderBrush="#FF3B82F6">
                        <StackPanel>
                            <md:PackIcon Kind="GoogleDrive" Width="38" Height="38"
                                         Foreground="#FF3B82F6"
                                         HorizontalAlignment="Center"
                                         Margin="0,0,0,8"/>
                            <TextBlock Text="Upload to Google Drive"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontWeight="SemiBold" FontSize="14"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtDriveStatus"
                                       Text="Direct upload to your account"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="11" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- GitHub Release -->
                    <Button Grid.Column="4" Click="BtnRelease_Click"
                            Style="{StaticResource DestinationCardButton}"
                            BorderBrush="#FFF59E0B">
                        <StackPanel>
                            <md:PackIcon Kind="Tag" Width="38" Height="38"
                                         Foreground="#FFF59E0B"
                                         HorizontalAlignment="Center"
                                         Margin="0,0,0,8"/>
                            <TextBlock Text="Upload as GitHub Release"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontWeight="SemiBold" FontSize="14"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtReleaseStatus"
                                       Text="Tagged assets, auto-split &gt; 1.95 GiB"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="11" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2" CornerRadius="0,0,16,16"
                        Background="#FF14141E" Padding="22,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Tip: you can change the default in Settings → Download Settings."
                                   Foreground="{StaticResource TextMuted}" FontSize="11"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="{StaticResource BorderBrushDefault}"
                                Foreground="{StaticResource TextSecondary}"
                                md:ButtonAssist.CornerRadius="10"
                                Padding="20,7"
                                Click="BtnCancel_Click" Content="Cancel"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
