<Window x:Class="OctoFetch.Views.Dialogs.YouTubeDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Download Options"
        Width="420" Height="310"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource BrandFont}"
        TextElement.Foreground="{StaticResource TextPrimary}"
        TextElement.FontSize="13">

    <Border Background="{StaticResource BgCard}" CornerRadius="14"
            BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1"
            Margin="8">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="Transfer video" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock x:Name="TxtVideoTitle" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Video quality -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="VIDEO QUALITY" Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="CmbQuality"
                          Style="{StaticResource CompactComboBox}"
                          md:HintAssist.Hint="Video quality" Height="36">
                    <ComboBoxItem Content="1080 (Full HD)" IsSelected="True"/>
                    <ComboBoxItem Content="720 (HD)"/>
                    <ComboBoxItem Content="480"/>
                    <ComboBoxItem Content="360"/>
                </ComboBox>
            </StackPanel>

            <!-- Audio quality -->
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="AUDIO QUALITY" Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="CmbAudioBitrate"
                          Style="{StaticResource CompactComboBox}"
                          md:HintAssist.Hint="Audio bitrate (kbps)" Height="36"
                          HorizontalAlignment="Left" Width="160">
                    <ComboBoxItem Content="320"/>
                    <ComboBoxItem Content="256"/>
                    <ComboBoxItem Content="192" IsSelected="True"/>
                    <ComboBoxItem Content="128"/>
                </ComboBox>
            </StackPanel>

            <!-- Buttons -->
            <Grid Grid.Row="4" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="{StaticResource BorderBrushDefault}"
                        Foreground="{StaticResource TextSecondary}"
                        md:ButtonAssist.CornerRadius="10"
                        Padding="18,6" Margin="0,0,8,0"
                        Click="BtnCancel_Click" Content="Cancel"/>
                <Button Grid.Column="2" Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{StaticResource AccentGradient}"
                        BorderBrush="{StaticResource AccentGradient}"
                        Foreground="White"
                        md:ButtonAssist.CornerRadius="10"
                        Padding="22,6"
                        Click="BtnDownload_Click">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="CloudUpload" Width="14" Height="14"
                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Transfer" VerticalAlignment="Center"
                                   FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
