<Window x:Class="OctoFetch.Views.Dialogs.DownloadSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Download Settings"
        Width="600" Height="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource BrandFont}"
        TextElement.Foreground="{StaticResource TextPrimary}"
        TextElement.FontSize="13">

    <Border Background="{StaticResource WindowBackdrop}" CornerRadius="16"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <Border CornerRadius="16" BorderThickness="1"
                BorderBrush="{StaticResource AccentGradient}"
                Background="{StaticResource BgCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============================== Header ============================== -->
                <Border Grid.Row="0" CornerRadius="16,16,0,0"
                        Background="#FF14141E" Padding="22,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar circle in brand accent gradient -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                                Background="{StaticResource AccentGradient}"
                                Margin="0,0,14,0">
                            <md:PackIcon Kind="DownloadMultiple" Width="22" Height="22"
                                         Foreground="White"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Download settings"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Concurrency and output folder for the built-in downloader"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="11.5" Margin="0,3,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                Width="30" Height="30"
                                Foreground="{StaticResource TextMuted}"
                                ToolTip="Close" Click="BtnCancel_Click">
                            <md:PackIcon Kind="WindowClose" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ============================== Body ============================== -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,18,22,8">

                        <!-- Concurrency card -->
                        <Border Background="#FF14141E" CornerRadius="12"
                                BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1"
                                Padding="16,14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                        Background="#FF1F1F2D" Margin="0,0,12,0">
                                    <md:PackIcon Kind="LightningBolt" Width="16" Height="16"
                                                 Foreground="{StaticResource AccentCyanBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Concurrent downloads"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="How many parallel transfers the downloader runs at once."
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11" Margin="0,2,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <ComboBox Grid.Column="2" x:Name="CmbConcurrency" Width="92"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource CompactComboBox}">
                                    <sys:Int32>1</sys:Int32>
                                    <sys:Int32>2</sys:Int32>
                                    <sys:Int32>3</sys:Int32>
                                    <sys:Int32>4</sys:Int32>
                                    <sys:Int32>5</sys:Int32>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Default upload destination -->
                        <Border Background="#FF14141E" CornerRadius="12"
                                BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1"
                                Padding="16,14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                        Background="#FF1F1F2D" Margin="0,0,12,0">
                                    <md:PackIcon Kind="CloudUploadOutline" Width="16" Height="16"
                                                 Foreground="#FF3B82F6"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Default upload destination"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Sets the Dashboard&apos;s destination selector. &quot;Ask every time&quot; hides the selector and pops a modal per upload."
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11" Margin="0,2,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <ComboBox Grid.Column="2" x:Name="CmbDestination" Width="170"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource CompactComboBox}"
                                          SelectionChanged="CmbDestination_SelectionChanged">
                                    <ComboBoxItem Tag="GitHub">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="Github" Width="14" Height="14"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="GitHub" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="GoogleDrive">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="GoogleDrive" Width="14" Height="14"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Google Drive" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="GitHubRelease">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="Tag" Width="14" Height="14"
                                                         Foreground="#FFF59E0B"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="GitHub Release" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="AskEveryTime">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="HelpCircleOutline" Width="14" Height="14"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Ask every time" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- GitHub Releases card -->
                        <Border Background="#FF14141E" CornerRadius="12"
                                BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1"
                                Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                            Background="#FF1F1F2D" Margin="0,0,12,0">
                                        <md:PackIcon Kind="Tag" Width="16" Height="16"
                                                     Foreground="#FFF59E0B"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="GitHub Releases"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="Versioned release assets. Files over 1.95 GiB auto-split into multiple parts."
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="11" Margin="0,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <ToggleButton Grid.Column="2" x:Name="ChkReleaseEnabled"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource CompactToggleSwitch}"
                                                  ToolTip="Enable or disable the GitHub Releases uploader"/>
                                </Grid>

                                <TextBlock Text="Default release tag"
                                           Foreground="{StaticResource TextSecondary}" FontSize="11.5"
                                           Margin="0,4,0,4"/>
                                <TextBox x:Name="TxtReleaseTag"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         md:HintAssist.Hint="e.g. co-releases-v1"
                                         md:HintAssist.IsFloating="False"
                                         FontSize="12" Padding="12,9"/>
                                <TextBlock Foreground="{StaticResource TextMuted}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0">
                                    <Run Text="A random 4-digit suffix is appended per upload to keep"/>
                                    <Run Text="multi-account / multi-token uploads from colliding"/>
                                    <Run Text="(e.g. &quot;co-releases-v1&quot; → &quot;co-releases-v1-3847&quot;)."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Output folder card -->
                        <Border Background="#FF14141E" CornerRadius="12"
                                BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1"
                                Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                            Background="#FF1F1F2D" Margin="0,0,12,0">
                                        <md:PackIcon Kind="FolderOpenOutline" Width="16" Height="16"
                                                     Foreground="{StaticResource AccentPurpleBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Output folder"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="Final files land in &quot;&lt;this folder&gt;\OctoFetch\&lt;category&gt;\&quot;."
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="11" Margin="0,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtFolder"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             md:HintAssist.Hint="C:\Users\you\Downloads"
                                             md:HintAssist.IsFloating="False"
                                             FontSize="12" Padding="12,9"/>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            BorderBrush="{StaticResource BorderBrushDefault}"
                                            Foreground="{StaticResource TextSecondary}"
                                            md:ButtonAssist.CornerRadius="10"
                                            Padding="14,7" Margin="10,0,0,0"
                                            Click="BtnBrowse_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="FolderSearchOutline" Width="13" Height="13"
                                                         Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Browse" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Hint strip -->
                        <Border Background="#FF14141E" CornerRadius="10"
                                BorderBrush="#FF1F2A3A" BorderThickness="1"
                                Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="InformationOutline" Width="14" Height="14"
                                             Foreground="{StaticResource InfoBrush}"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Foreground="{StaticResource TextSecondary}"
                                           FontSize="11.5" TextWrapping="Wrap"
                                           VerticalAlignment="Center">
                                    <Run Text="Tip:"/>
                                    <Run Foreground="{StaticResource TextMuted}"
                                         Text="leave concurrency at 2 unless you're on fiber — more parallel transfers don't necessarily mean faster downloads on home connections."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================== Footer ============================== -->
                <Border Grid.Row="2" CornerRadius="0,0,16,16"
                        Background="#FF14141E" Padding="22,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="{StaticResource BorderBrushDefault}"
                                Foreground="{StaticResource TextSecondary}"
                                md:ButtonAssist.CornerRadius="10"
                                Padding="20,7" Margin="0,0,10,0"
                                Click="BtnCancel_Click" Content="Cancel"/>
                        <Button Grid.Column="2" Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{StaticResource AccentGradient}"
                                BorderBrush="{StaticResource AccentGradient}"
                                Foreground="White"
                                md:ButtonAssist.CornerRadius="10"
                                Padding="24,7"
                                Click="BtnSave_Click">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ContentSave" Width="14" Height="14"
                                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Save" VerticalAlignment="Center"
                                           FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
