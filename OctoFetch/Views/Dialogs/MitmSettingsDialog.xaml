<Window x:Class="OctoFetch.Views.Dialogs.MitmSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="MITM engine"
        Width="880" Height="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource BrandFont}"
        TextElement.Foreground="{StaticResource TextPrimary}"
        TextElement.FontSize="13">
    <Window.Resources>
        
        <Style x:Key="MitmTabPill" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background"
                                        Value="{StaticResource AccentGradient}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBackdrop}" CornerRadius="16" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <Border CornerRadius="16" BorderThickness="1"
                BorderBrush="{StaticResource AccentGradient}"
                Background="{StaticResource BgCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" CornerRadius="16,16,0,0"
                        Background="#FF14141E" Padding="32,24">
                    <Grid MouseDown="Header_MouseDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23"
                                Background="{StaticResource AccentGradient}"
                                Margin="0,0,18,0">
                            <md:PackIcon Kind="ShieldKey" Width="22" Height="22"
                                         Foreground="White"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="MITM engine"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Front-loaded TLS bypass for YouTube search, Drive OAuth, the Drive file manager &amp; thumbnails."
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="12" Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                Width="32" Height="32"
                                Foreground="{StaticResource TextMuted}"
                                ToolTip="Close" Click="BtnClose_Click"
                                VerticalAlignment="Top">
                            <md:PackIcon Kind="WindowClose" Width="15" Height="15"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Tab pills -->
                <Border Grid.Row="1" Background="#FF0F0F18" Padding="32,16,32,16"
                        BorderBrush="#FF1F1F2C" BorderThickness="0,1,0,1">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="TabSettings"
                                      Style="{StaticResource MitmTabPill}"
                                      IsChecked="True"
                                      Checked="TabSettings_Checked"
                                      Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="CogOutline" Width="14" Height="14"
                                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Settings &amp; Test" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="TabConfig"
                                      Style="{StaticResource MitmTabPill}"
                                      Checked="TabConfig_Checked">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="CodeJson" Width="14" Height="14"
                                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Edit config" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- Body (two tab panes stacked, swap on toggle) -->
                <Grid Grid.Row="2">

                    <!-- ============================== TAB 1: Settings & Test ============================== -->
                    
                    <ScrollViewer x:Name="PaneSettings"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,26,32,26" HorizontalAlignment="Stretch">
                            
                            <Border x:Name="ErrorBanner" Background="#FF2A1212"
                                    CornerRadius="12" Padding="18,14" Margin="0,0,0,18"
                                    BorderBrush="#FFEF4444" BorderThickness="1"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <md:PackIcon Grid.Column="0" Kind="AlertCircleOutline"
                                                 Width="22" Height="22" Foreground="#FFEF4444"
                                                 VerticalAlignment="Top" Margin="0,1,14,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Engine failed to start"
                                                   Foreground="#FFFCA5A5"
                                                   FontWeight="SemiBold" FontSize="13.5"/>
                                        <TextBlock x:Name="LblStartError"
                                                   Foreground="#FFFCA5A5"
                                                   FontSize="12" Margin="0,6,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Master toggle -->
                            <Border Background="#FF14141E" CornerRadius="14" Padding="24" Margin="0,0,0,18"
                                    BorderBrush="#FF2A2A3E" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21"
                                            Background="#FF1A1A28" BorderBrush="#FF8B5CF6" BorderThickness="1"
                                            Margin="0,0,18,0" VerticalAlignment="Center">
                                        <md:PackIcon Kind="PowerStandby" Width="20" Height="20"
                                                     Foreground="#FF8B5CF6"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Enable MITM engine"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontWeight="SemiBold" FontSize="14.5"/>
                                        <TextBlock Text="Spins up xray-core on demand for YouTube search, Drive OAuth, the Drive file manager, and thumbnail loading. Stays off for everything else."
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="12" Margin="0,6,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="2"
                                                  x:Name="TogEnable"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  Checked="TogEnable_Toggled"
                                                  Unchecked="TogEnable_Toggled"/>
                                </Grid>
                            </Border>

                            <!-- Connection check (big primary action) -->
                            <Border Background="#FF14141E" CornerRadius="14" Padding="24" Margin="0,0,0,18"
                                    BorderBrush="#FF2A2A3E" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21"
                                                Background="#FF1A1A28" BorderBrush="#FF3B82F6" BorderThickness="1"
                                                Margin="0,0,18,0" VerticalAlignment="Top">
                                            <md:PackIcon Kind="Wifi" Width="20" Height="20"
                                                         Foreground="#FF3B82F6"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Connection check"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontWeight="SemiBold" FontSize="14.5"/>
                                            <TextBlock Text="Probes YouTube, Drive, and a generic Google endpoint through the proxy. Each leg fails independently so you can tell which route is broken."
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                x:Name="BtnCheck"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Background="#FF3B82F6" BorderBrush="#FF3B82F6"
                                                Foreground="White"
                                                Click="BtnCheck_Click"
                                                md:ButtonAssist.CornerRadius="8"
                                                Padding="18,8"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="Refresh" Width="14" Height="14"
                                                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="Check now" VerticalAlignment="Center"
                                                           FontSize="12.5" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Probe results grid (visible after first check) -->
                                    <Border x:Name="HealthPanel"
                                            Background="#FF0F0F18" CornerRadius="10" Padding="18"
                                            BorderBrush="#FF1F1F2C" BorderThickness="1"
                                            Visibility="Collapsed">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" x:Name="EllYouTube"
                                                         Width="10" Height="10" Margin="0,0,12,0"
                                                         Fill="#FF6B7280" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="YouTube"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" x:Name="LblYouTube"
                                                           Text="pending"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>

                                            <Grid Grid.Row="1" Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" x:Name="EllDrive"
                                                         Width="10" Height="10" Margin="0,0,12,0"
                                                         Fill="#FF6B7280" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Google Drive"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" x:Name="LblDrive"
                                                           Text="pending"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>

                                            <Grid Grid.Row="2" Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" x:Name="EllPing"
                                                         Width="10" Height="10" Margin="0,0,12,0"
                                                         Fill="#FF6B7280" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Google ping"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" x:Name="LblPing"
                                                           Text="pending"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Two maintenance cards. Vertical layout (header row on top, button row at the bottom) so neither title nor description gets squeezed. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Uninstall cert -->
                                <Border Grid.Column="0" Background="#FF14141E" CornerRadius="14" Padding="22"
                                        BorderBrush="#FF2A2A3E" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <Border Width="34" Height="34" CornerRadius="17"
                                                    Background="#FF2A1A1A" BorderBrush="#FFEF4444" BorderThickness="1"
                                                    Margin="0,0,12,0">
                                                <md:PackIcon Kind="Delete" Width="16" Height="16"
                                                             Foreground="#FFEF4444"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Remove certificate"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontWeight="SemiBold" FontSize="13.5"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1"
                                                   Text="Removes the local MITM root CA from the Windows trust store."
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="11.5" TextWrapping="Wrap"
                                                   Margin="0,12,0,14"/>
                                        <Button Grid.Row="2"
                                                x:Name="BtnUninstall"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                BorderBrush="#FFEF4444" Foreground="#FFEF4444"
                                                Click="BtnUninstall_Click"
                                                md:ButtonAssist.CornerRadius="8"
                                                Padding="16,6"
                                                HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="DeleteOutline" Width="13" Height="13"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Remove" VerticalAlignment="Center"
                                                           FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Restore default config -->
                                <Border Grid.Column="2" Background="#FF14141E" CornerRadius="14" Padding="22"
                                        BorderBrush="#FF2A2A3E" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <Border Width="34" Height="34" CornerRadius="17"
                                                    Background="#FF2A220A" BorderBrush="#FFF59E0B" BorderThickness="1"
                                                    Margin="0,0,12,0">
                                                <md:PackIcon Kind="Restore" Width="16" Height="16"
                                                             Foreground="#FFF59E0B"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Restore default config"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontWeight="SemiBold" FontSize="13.5"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1"
                                                   Text="Replaces the editable JSON with the bundled defaults."
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="11.5" TextWrapping="Wrap"
                                                   Margin="0,12,0,14"/>
                                        <Button Grid.Row="2"
                                                x:Name="BtnRestore"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                BorderBrush="#FFF59E0B" Foreground="#FFF59E0B"
                                                Click="BtnRestore_Click"
                                                md:ButtonAssist.CornerRadius="8"
                                                Padding="16,6"
                                                HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="Restore" Width="13" Height="13"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Restore" VerticalAlignment="Center"
                                                           FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================== TAB 2: Edit config ============================== -->
                    <Grid x:Name="PaneConfig" Visibility="Collapsed"
                          Margin="32,26,32,26"
                          HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FF14141E" CornerRadius="14" Padding="22"
                                BorderBrush="#FF2A2A3E" BorderThickness="1" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                        Background="#FF1A1A28" BorderBrush="#FF8B5CF6" BorderThickness="1"
                                        Margin="0,0,14,0" VerticalAlignment="Center">
                                    <md:PackIcon Kind="CodeJson" Width="18" Height="18"
                                                 Foreground="#FF8B5CF6"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="MITM-DomainFronting.json"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontWeight="SemiBold" FontSize="13.5"/>
                                    <TextBlock Text="JSON is validated on save. The engine restarts on the next YouTube / Drive operation."
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11.5" Margin="0,4,12,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        x:Name="BtnSaveConfig"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="{StaticResource AccentGradient}"
                                        BorderBrush="{StaticResource AccentGradient}"
                                        Foreground="White"
                                        Click="BtnSaveConfig_Click"
                                        md:ButtonAssist.CornerRadius="8"
                                        Padding="18,7" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="ContentSave" Width="13" Height="13"
                                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Save config" VerticalAlignment="Center"
                                                   FontSize="12.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#FF0F0F18" CornerRadius="12"
                                BorderBrush="#FF1F1F2C" BorderThickness="1">
                            <TextBox x:Name="TxtConfig"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"
                                     FontFamily="Consolas, Cascadia Mono, Menlo, monospace"
                                     FontSize="12"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextPrimary}"
                                     BorderThickness="0"
                                     Padding="14"/>
                        </Border>

                        <TextBlock Grid.Row="2"
                                   x:Name="LblConfigError"
                                   Foreground="#FFEF4444" FontSize="11.5"
                                   Margin="0,10,0,0" Visibility="Collapsed"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Grid>

                <!-- Footer status strip -->
                <Border Grid.Row="3" Background="#FF0F0F18" CornerRadius="0,0,16,16" Padding="32,16"
                        BorderBrush="#FF1F1F2C" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="EllEngine" Width="9" Height="9"
                                     Fill="#FF6B7280" Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblEngine" Text="Engine: stopped"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="12" Margin="0,0,26,0"
                                       VerticalAlignment="Center"/>
                            <Ellipse x:Name="EllCert" Width="9" Height="9"
                                     Fill="#FF6B7280" Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblCert" Text="Cert: missing"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="Close"
                                Click="BtnClose_Click"
                                md:ButtonAssist.CornerRadius="8"
                                Padding="22,6"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
