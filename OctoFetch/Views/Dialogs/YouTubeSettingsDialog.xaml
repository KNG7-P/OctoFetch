<Window x:Class="OctoFetch.Views.Dialogs.YouTubeSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="YouTube API"
        Width="540" Height="260"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource BrandFont}"
        TextElement.Foreground="{StaticResource TextPrimary}"
        TextElement.FontSize="13">

    <Border Background="{StaticResource BgCard}" CornerRadius="14"
            BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1"
            Margin="8">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="YouTube Data API" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Used for search and channel browsing. A v3 API key is required."
                           Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,4,0,0"/>
            </StackPanel>

            <TextBox Grid.Row="1" x:Name="TxtApiKey"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     md:HintAssist.Hint="YouTube Data API v3 Key"
                     md:HintAssist.IsFloating="True"
                     FontSize="12.5" Padding="12,10"/>

            <!-- Buttons -->
            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="{StaticResource BorderBrushDefault}"
                        Foreground="{StaticResource TextSecondary}"
                        md:ButtonAssist.CornerRadius="10"
                        Padding="18,6" Margin="0,0,8,0"
                        Click="BtnCancel_Click" Content="Cancel"/>
                <Button Grid.Column="2" Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{StaticResource AccentGradient}"
                        BorderBrush="{StaticResource AccentGradient}"
                        Foreground="White"
                        md:ButtonAssist.CornerRadius="10"
                        Padding="22,6"
                        Click="BtnSave_Click">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ContentSave" Width="14" Height="14"
                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Save" VerticalAlignment="Center"
                                   FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
