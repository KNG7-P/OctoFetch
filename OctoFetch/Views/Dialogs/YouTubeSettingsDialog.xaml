<Window x:Class="OctoFetch.Views.Dialogs.YouTubeSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="YouTube Settings"
        Width="560" Height="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource BrandFont}"
        TextElement.Foreground="{StaticResource TextPrimary}"
        TextElement.FontSize="13">

    <Border Background="{StaticResource BgCard}" CornerRadius="14"
            BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1"
            Margin="8">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="YouTube Settings" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="YouTube Data API v3 keys used for in-app search."
                           Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Body -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="Data API Keys" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,8"
                           Text="Add one key per line. Search load is rotated across keys; exhausted keys are skipped for the rest of the session. Each key allows ~100 searches/day."/>

                <TextBox x:Name="TxtApiKeys"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="YouTube Data API v3 keys (one per line)"
                         md:HintAssist.IsFloating="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         MinHeight="170"
                         FontSize="12" Padding="12,10"/>
            </StackPanel>

            <!-- Buttons -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="{StaticResource BorderBrushDefault}"
                        Foreground="{StaticResource TextSecondary}"
                        md:ButtonAssist.CornerRadius="10"
                        Padding="18,6" Margin="0,0,8,0"
                        Click="BtnCancel_Click" Content="Cancel"/>
                <Button Grid.Column="2" Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{StaticResource AccentGradient}"
                        BorderBrush="{StaticResource AccentGradient}"
                        Foreground="White"
                        md:ButtonAssist.CornerRadius="10"
                        Padding="22,6"
                        Click="BtnSave_Click">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ContentSave" Width="14" Height="14"
                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Save" VerticalAlignment="Center"
                                   FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
